# Salesforce CLI local state and caches — machine-specific, never share these.
# .sfdx/ in particular holds the downloaded StandardApexLibrary stubs and org
# auth scratch data, which is why it must not be tracked.
.sfdx/
.sf/
.localdevserver/
deploy-options.json

# LWC editor scaffolding, regenerated by the Salesforce extensions
**/lwc/jsconfig.json
**/lwc/.eslintrc.json
**/aura/.eslintrc.json

# Test output
coverage/
.nyc_output/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies and tooling caches
node_modules/
.eslintcache

# OS cruft
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
